---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Leaderboard">
  <Fragment slot="head">
    <link rel="stylesheet" href="https://unpkg.com/tabulator-tables@6.3.0/dist/css/tabulator_simple.min.css" />
  </Fragment>

  <h1>Bullish Oscillators — "Stocks like ZETA"</h1>
  <p>
    Stocks that <strong>net-trend up</strong> while swinging ±10% up and down repeatedly.
    Ranked by <code>bullish_score</code> (= oscillation <strong>activity</strong> × signed
    <strong>trend</strong>). Each dot is a stock; the <strong>top-right</strong> — strong
    uptrend <em>and</em> many two-sided swings — is the most ZETA-like.
    <strong>ZETA</strong> is highlighted as the archetype.
  </p>

  <p id="bullish-meta"><em>Loading screen…</em></p>

  <div id="bullish-scatter" style="min-height:520px;"></div>

  <h2>Leaderboard</h2>

  <p style="margin-bottom:0.5rem;">
    Don't see a stock?
    <a href="https://github.com/sivadotblog/stock-threshold-analyzer/issues/new?template=add-ticker.md&title=Add+ticker%3A+XXXX&labels=add-ticker"
       target="_blank" rel="noopener"
       style="font-weight:600;">Open a GitHub issue to request it →</a>
  </p>

  <div id="tb-filters" class="tb-filter-bar">
    <div class="tb-filter-group">
      <label for="f-ticker">Ticker</label>
      <input type="text" id="f-ticker" placeholder="e.g. RKLB" autocomplete="off" />
    </div>
    <div class="tb-filter-group">
      <label for="f-rank-max">Rank ≤</label>
      <input type="number" id="f-rank-max" placeholder="e.g. 100" min="1" />
    </div>
    <div class="tb-filter-group">
      <label for="f-score-min">Score ≥</label>
      <input type="number" id="f-score-min" placeholder="e.g. 0.5" step="0.01" min="0" max="1" />
    </div>
    <div class="tb-filter-group">
      <label>CAGR%</label>
      <div class="tb-filter-range">
        <input type="number" id="f-cagr-min" placeholder="min" />
        <span>–</span>
        <input type="number" id="f-cagr-max" placeholder="max" />
      </div>
    </div>
    <div class="tb-filter-group">
      <label>MaxDD%</label>
      <div class="tb-filter-range">
        <input type="number" id="f-dd-min" placeholder="e.g. −90" />
        <span>–</span>
        <input type="number" id="f-dd-max" placeholder="e.g. −20" />
      </div>
    </div>
    <div class="tb-filter-group tb-filter-group--btn">
      <button id="f-reset">Reset</button>
    </div>
  </div>

  <div id="bullish-table"></div>

  <div class="field-legend">
    <h2>Field Descriptions</h2>
    <table>
      <thead><tr><th>Field</th><th>What it means</th></tr></thead>
      <tbody>
        <tr>
          <td><strong>Score</strong></td>
          <td>Composite 0–1 rating: how much this stock behaves like ZETA. Combines how often it swings ±10% <em>and</em> whether those swings are net upward. 1.0 = perfect bullish oscillator, 0 = doesn't qualify.</td>
        </tr>
        <tr>
          <td><strong>Streak</strong></td>
          <td>Current momentum. How many consecutive ±10% threshold crossings have gone the same direction. <code>+3↑</code> = the last 3 events were all up legs. <code>-2↓</code> = last 2 were down legs. A pill badge shows if the streak changed today.</td>
        </tr>
        <tr>
          <td><strong>CAGR%</strong></td>
          <td>Compound Annual Growth Rate — the annualized return over the 5-year lookback. 20% means the stock roughly doubled every ~3.5 years on average.</td>
        </tr>
        <tr>
          <td><strong>MaxDD%</strong></td>
          <td>Maximum Drawdown — the worst peak-to-trough drop over the 5 years. High scores often come with brutal drawdowns because volatile stocks swing hard in both directions.</td>
        </tr>
        <tr>
          <td><strong>↑/↓</strong></td>
          <td>Raw count of up-legs / down-legs. A balanced ratio means it swings both ways, which is what the screener rewards.</td>
        </tr>
      </tbody>
    </table>
  </div>

  <script is:inline src="https://unpkg.com/tabulator-tables@6.3.0/dist/js/tabulator.min.js"></script>
  <script is:inline src={`${base}/js/bullish-screen.js`}></script>
</Base>
